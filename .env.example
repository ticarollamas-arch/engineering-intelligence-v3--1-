# Refinamento por IA (opcional). Sem estas variáveis o app usa só o motor local.
# AI_PROVIDER: "openai" (qualquer API compatível com OpenAI) ou "gemini"
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Para provedores compatíveis com OpenAI (Groq, OpenRouter, DeepSeek, NVIDIA...):
AI_BASE_URL=https://api.openai.com/v1
# Limites para não consumir a cota sem controle
AI_LIMIT_PER_IP=5
AI_LIMIT_WINDOW_MIN=60
AI_DAILY_LIMIT=100
AI_MAX_TOKENS=2500

# Pesquisa (opcional)
# Token do GitHub só aumenta o limite da busca pública de repositórios (nenhuma permissão é necessária)
GITHUB_TOKEN=
RESEARCH_LIMIT_PER_IP=20
